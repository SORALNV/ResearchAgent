# Worker only. Do not copy Discord, OpenAI, or Kaggle credentials here.
RESEARCH_WORKER_TOKEN=
RESEARCH_WORKER_HOST=0.0.0.0
RESEARCH_WORKER_PORT=8090
RESEARCH_WORKER_DATA_DIR=/var/lib/research-agent/worker
RESEARCH_WORKER_PUBLIC_URL=http://127.0.0.1:8090

RESEARCH_WORKER_ACCELERATORS=cpu,gpu
RESEARCH_WORKER_MAX_VRAM_GB=
RESEARCH_WORKER_MAX_GPU_COUNT=
RESEARCH_WORKER_MAX_CPU_CORES=
RESEARCH_WORKER_MAX_RAM_GB=
RESEARCH_WORKER_MAX_RUNTIME_MINUTES=
RESEARCH_WORKER_NETWORK_AVAILABLE=true
RESEARCH_WORKER_TAGS=training,inference,remote_worker,smoke_test
RESEARCH_WORKER_MAX_BUNDLE_FILES=5000
RESEARCH_WORKER_MAX_BUNDLE_BYTES=67108864

WORKER_BIND_ADDRESS=127.0.0.1
WORKER_PORT=8090
NVIDIA_VISIBLE_DEVICES=all
NVIDIA_DRIVER_CAPABILITIES=compute,utility
