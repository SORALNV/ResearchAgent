# Discord
DISCORD_BOT_TOKEN=
DISCORD_CHANNEL_ID=
DISCORD_IMPORTANT_CHANNEL_ID=
DISCORD_LOG_CHANNEL_ID=
DISCORD_WORKER_QUEUE_SIZE=32

# Discord channel -> domain routing. Unknown channels fail closed.
# Exact channel/thread IDs override parent-channel inheritance.
# Compact syntax: 123456789012345678=research,234567890123456789=kaggle
# JSON object syntax is also accepted.
DISCORD_CHANNEL_DOMAIN_MAP=
DISCORD_RESEARCH_CHANNEL_IDS=
DISCORD_KAGGLE_CHANNEL_IDS=
# Preferred channel-native registry bootstrap. Each key is one Discord
# channel and each value contains mode, subject, and optional target.
DISCORD_CHANNEL_SESSIONS_JSON=
# Relative paths are resolved under PROJECT_ROOT.
CONTROL_PLANE_DIR=control_plane
# Explicit execution requests create one child Discord Thread used as a live
# progress log while retaining the parent channel's Project/WorkSession/Codex
# context. Discord does not support nested Threads, so requests sent inside a
# Thread reuse that Thread.
DISCORD_EXECUTION_THREADS=true
# Historical setting retained for configuration compatibility.
DISCORD_CREATE_THREADS=false

# Autonomous compute scheduler. Accepted hypotheses become durable Jobs and are
# executed outside the Discord response path. Relative paths use PROJECT_ROOT.
COMPUTE_RUNTIME_DIR=compute_runtime
COMPUTE_MAX_CONCURRENT_JOBS=2
COMPUTE_POLL_INTERVAL_SECONDS=15
COMPUTE_LEASE_SECONDS=300
COMPUTE_MAX_UNKNOWN_POLLS=8
COMPUTE_MAX_HYPOTHESIS_PROPOSALS=5
COMPUTE_SMOKE_TIMEOUT_SECONDS=180
COMPUTE_ARTIFACT_MAX_FILES=1000
COMPUTE_ARTIFACT_MAX_BYTES=1073741824
COMPUTE_WORKER_ID=

# Default routing. A Job's backend_preferences are tried before these lists.
# local_gpu_worker is the secret-free sidecar from compose.local-gpu.yaml.
COMPUTE_KAGGLE_BACKEND_ORDER=kaggle_notebook,local_gpu_worker,remote_gpu
COMPUTE_RESEARCH_BACKEND_ORDER=local_gpu_worker,remote_gpu

# Direct Core-process execution is disabled because Core owns Discord/OpenAI/
# Codex/Kaggle credentials and has no strong filesystem/network sandbox for
# arbitrary experiment code. Enable only for fully trusted code outside the
# normal autonomous path. Prefer the Worker sidecar even on the same machine.
LOCAL_PROCESS_COMPUTE_ENABLED=false
LOCAL_GPU_ENABLED=auto
LOCAL_GPU_COUNT=
LOCAL_GPU_MEMORY_MB=
LOCAL_GPU_MAX_CPU_CORES=
LOCAL_GPU_MAX_MEMORY_MB=
LOCAL_GPU_MAX_STORAGE_MB=
LOCAL_CPU_MAX_CORES=
LOCAL_CPU_MAX_MEMORY_MB=
LOCAL_CPU_MAX_STORAGE_MB=
# This is backend capability metadata, not an OS-level network firewall.
LOCAL_COMPUTE_NETWORK_AVAILABLE=false

# Local GPU Worker sidecar (`compose.local-gpu.yaml`). This token is shared only
# between Core and that secret-minimal sidecar and must differ from all other
# tokens. The sidecar receives no Discord/OpenAI/Codex/Kaggle credentials.
LOCAL_GPU_WORKER_TOKEN=
LOCAL_GPU_WORKER_NETWORK_AVAILABLE=false
LOCAL_GPU_WORKER_LABELS=training,inference,remote_worker,smoke_test
RA_LOCAL_GPU_WORKER_RUNTIME_DIR=./local-gpu-worker-runtime

# Kaggle Notebook backend. Credentials stay in Core and are never copied to
# Codex/OpenAI or experiment subprocess environments. Capacity values must
# describe the currently available Kaggle Notebook tier. If a Job requires a
# capacity that is left blank, routing fails closed instead of guessing.
KAGGLE_COMMAND=kaggle
KAGGLE_COMMAND_TIMEOUT_SECONDS=180
KAGGLE_GPU_COUNT=1
KAGGLE_GPU_MEMORY_MB=
KAGGLE_CPU_CORES=
KAGGLE_MEMORY_MB=
KAGGLE_STORAGE_MB=
KAGGLE_USERNAME=
KAGGLE_KEY=
KAGGLE_API_TOKEN=

# One owned/external GPU Worker. The token stays in Core. Set PAID=true for a
# rented VM/Cloud worker so the scheduler pauses for an operational approval.
REMOTE_GPU_WORKER_NAME=remote_gpu
REMOTE_GPU_WORKER_URL=
REMOTE_GPU_WORKER_TOKEN=
REMOTE_GPU_WORKER_PAID=false
REMOTE_GPU_WORKER_GPU_COUNT=1
REMOTE_GPU_WORKER_GPU_MEMORY_MB=
REMOTE_GPU_WORKER_NETWORK_AVAILABLE=true
REMOTE_GPU_WORKER_LABELS=training,inference,remote_worker
REMOTE_WORKER_TIMEOUT_SECONDS=45
REMOTE_BUNDLE_MAX_FILES=5000
REMOTE_BUNDLE_MAX_BYTES=67108864

# Multiple workers may be declared as a JSON array. Prefer token_env so a token
# is referenced by environment-variable name instead of repeated in JSON.
# Example: [{"name":"gpu96","base_url":"http://host:8090","token_env":"GPU96_TOKEN","paid":false,"capabilities":{"accelerators":["gpu"],"domains":["research","kaggle"],"gpu_count":1,"gpu_memory_mb":98304,"labels":["training","remote_worker"]}}]
COMPUTE_REMOTE_WORKERS_JSON=

# Standalone external Worker process (`python -m harness.compute_worker`). Use
# deploy/.env.worker in production rather than sharing this Core environment.
# A Worker receives no Discord, OpenAI, Codex, or Kaggle credentials.
WORKER_TOKEN=
WORKER_HOST=0.0.0.0
WORKER_PORT=8090
WORKER_PUBLIC_URL=
WORKER_DATA_DIR=worker-runtime
WORKER_ACCELERATORS=cpu,gpu
WORKER_DOMAINS=research,kaggle
WORKER_GPU_COUNT=1
WORKER_GPU_MEMORY_MB=
WORKER_CPU_CORES=
WORKER_MEMORY_MB=
WORKER_STORAGE_MB=
WORKER_NETWORK_AVAILABLE=true
WORKER_LABELS=training,inference,remote_worker,smoke_test
WORKER_MAX_BUNDLE_FILES=5000
WORKER_MAX_BUNDLE_BYTES=67108864
WORKER_ARTIFACT_MAX_FILES=2000
WORKER_ARTIFACT_MAX_BYTES=4294967296
WORKER_MAX_REQUEST_BYTES=100663296

# Paths inside the container/runtime
PROJECT_ROOT=.
RESEARCH_ARCHIVE_DIR=research_runs
CODEX_HOME=/home/research/.codex
# Host directories mounted by compose.yaml. These paths stay outside the image.
RA_RUNTIME_DIR=./runtime
RA_RESEARCH_DIR=./research_runs
RA_CODEX_HOME_DIR=./codex-home
RA_WORKER_RUNTIME_DIR=./worker-runtime

# Codex App Server. One long-lived official App Server process owns Codex Core /
# Harness threads. Discord WorkSession IDs are durably mapped to Codex thread IDs.
# `codex exec` is not used by the routed provider path.
CODEX_APP_SERVER_COMMAND=codex app-server --listen stdio://
CODEX_APP_SERVER_STATE_DIR=codex_app_server
CODEX_APP_SERVER_REQUEST_TIMEOUT_SECONDS=30
# Blank means no client-side turn deadline. Discord interrupt remains available.
CODEX_APP_SERVER_TURN_TIMEOUT_SECONDS=
CODEX_APP_SERVER_APPROVAL_POLICY=on-request
# Keep this as `user` so approval requests reach Discord instead of an auto reviewer.
CODEX_APP_SERVER_APPROVALS_REVIEWER=user
CODEX_APP_SERVER_MODEL=
CODEX_APP_SERVER_REASONING_EFFORT=
CODEX_APP_SERVER_REASONING_SUMMARY=
CODEX_APP_SERVER_PERSONALITY=
CODEX_APP_SERVER_NETWORK_ACCESS=false

# Runtime provider routing. Missing role-specific values inherit AGENT_RUNTIME_ORDER.
# `codex_cli` is accepted only as a compatibility alias and is also routed to
# Codex App Server; it never restores the removed per-call `codex exec` path.
AGENT_RUNTIME_ORDER=codex_app_server,openai_responses
MAIN_AGENT_RUNTIME_ORDER=codex_app_server,openai_responses
SUB_AGENT_RUNTIME_ORDER=codex_app_server
REVIEW_AGENT_RUNTIME_ORDER=openai_responses,codex_app_server
FRESH_AGENT_RUNTIME_ORDER=openai_responses,codex_app_server
PLANNING_AGENT_RUNTIME_ORDER=codex_app_server,openai_responses
CLAUDE_AGENT_RUNTIME_ORDER=codex_app_server,openai_responses
RUNTIME_EVENT_LOG_ENABLED=true

# Generic non-Codex subprocess providers only. Leave these blank for the normal
# App Server deployment. A legacy value of bare `codex` is intercepted and
# routed to App Server rather than executed as a child `codex exec` process.
MAIN_AGENT_COMMAND=
SUB_AGENT_COMMAND=
REVIEW_AGENT_COMMAND=
FRESH_AGENT_COMMAND=
CLAUDE_AGENT_COMMAND=

# OpenAI Responses provider. Keep the API key outside source control.
# The key is consumed by the orchestrator process and is not forwarded to local
# Agent subprocesses unless explicitly added to AGENT_ENV_ALLOWLIST.
OPENAI_API_KEY=
OPENAI_BASE_URL=
OPENAI_MODEL=
OPENAI_REASONING_EFFORT=
OPENAI_REQUEST_TIMEOUT_SECONDS=120
OPENAI_MAX_RETRIES=1

# OpenAI Computer Use. Disabled by default. Enabling it also requires a separate
# bridge that owns the browser/desktop and returns screenshots after each action.
OPENAI_COMPUTER_ENABLED=false
OPENAI_COMPUTER_MODEL=
OPENAI_COMPUTER_BRIDGE_URL=
OPENAI_COMPUTER_BRIDGE_TOKEN=
OPENAI_COMPUTER_MAX_STEPS=20
OPENAI_COMPUTER_ALLOWED_STAGES=
OPENAI_COMPUTER_REQUIRE_APPROVAL=true

# Multi-agent execution
SUB_AGENT_COUNT=3
AGENT_PARALLELISM=3
MAX_REVIEW_RETRIES=1
MAX_PROTOCOL_RETRIES=1
AGENT_OUTPUT_CHAR_LIMIT=12000
MAX_COMMAND_SECONDS=300

# Process hardening
# isolated: each invocation receives a dedicated HOME while CODEX_HOME remains
# a separately mounted persistent authentication/config directory.
# preserve: exposes the parent HOME and should be used only for compatibility.
AGENT_HOME_MODE=isolated
# Additional variables explicitly forwarded only to local Agent subprocesses.
# DISCORD_* variables are hard-denied even when listed here.
AGENT_ENV_ALLOWLIST=
AGENT_CANCEL_GRACE_SECONDS=3
CHECKPOINT_ENABLED=true
ARTIFACT_PROMOTION_ENABLED=true
ARTIFACT_MAX_FILES=500
ARTIFACT_MAX_BYTES=104857600

# OS sandbox for non-Codex generic commands only. App Server receives the
# official per-thread/per-turn Codex sandbox policy directly.
# auto: use bubblewrap when installed; otherwise reject generic commands.
# bwrap: require bubblewrap. none: no OS sandbox.
AGENT_SANDBOX_BACKEND=auto
AGENT_ALLOW_UNSANDBOXED_GENERIC=false
AGENT_NETWORK_POLICY=deny

# Research limits and convergence
MAX_ROUNDS=3
FRESH_INTERVAL=1
CONVERGENCE_PATIENCE=2
CONVERGENCE_NO_EVIDENCE_PATIENCE=2
CONVERGENCE_MIN_PROGRESS=0.05
CONVERGENCE_REQUIRE_HIGH_CONFIDENCE=true
REPORT_INTERVAL_SECONDS=60
MAX_TURNS_PER_CONVERSATION=4
CONVERSATION_TIMEOUT_SECONDS=60
MAX_AGENT_CALLS=0
MAX_API_CALLS=0
MAX_TOTAL_TOKENS=0

# Literature search
PAPER_PROVIDER=arxiv
