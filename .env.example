# Discord
DISCORD_BOT_TOKEN=
DISCORD_CHANNEL_ID=
DISCORD_IMPORTANT_CHANNEL_ID=
DISCORD_LOG_CHANNEL_ID=
DISCORD_WORKER_QUEUE_SIZE=32

# Paths. compose.yaml overrides these with /data paths inside the container.
PROJECT_ROOT=.
RESEARCH_ARCHIVE_DIR=research_runs

# Real-agent commands. A bare `codex` uses Codex's own harness and sandbox.
MAIN_AGENT_COMMAND=codex
SUB_AGENT_COMMAND=codex
REVIEW_AGENT_COMMAND=codex
FRESH_AGENT_COMMAND=codex
CLAUDE_AGENT_COMMAND=

# Runtime provider routing.
# Supported: cli, codex_cli, openai_responses, openai_computer
# Providers are tried left-to-right. Computer Use is deliberately not in the
# default chain and remains disabled until explicitly configured.
AGENT_RUNTIME_ORDER=codex_cli,openai_responses
MAIN_AGENT_RUNTIME_ORDER=codex_cli,openai_responses
SUB_AGENT_RUNTIME_ORDER=codex_cli,openai_responses
REVIEW_AGENT_RUNTIME_ORDER=openai_responses,codex_cli
FRESH_AGENT_RUNTIME_ORDER=openai_responses,codex_cli
PLANNING_AGENT_RUNTIME_ORDER=openai_responses,codex_cli
CLAUDE_AGENT_RUNTIME_ORDER=cli
RUNTIME_EVENT_LOG_ENABLED=true

# OpenAI Responses fallback. Keep the model explicit because model availability
# differs by account and changes over time.
OPENAI_API_KEY=
OPENAI_BASE_URL=
OPENAI_MODEL=
OPENAI_REASONING_EFFORT=
OPENAI_REQUEST_TIMEOUT_SECONDS=120
OPENAI_MAX_RETRIES=1

# Optional OpenAI Computer Use fallback. It requires a separate browser/desktop
# bridge and a harness approval before any GUI session begins.
OPENAI_COMPUTER_ENABLED=false
OPENAI_COMPUTER_MODEL=
OPENAI_COMPUTER_BRIDGE_URL=
OPENAI_COMPUTER_BRIDGE_TOKEN=
OPENAI_COMPUTER_MAX_STEPS=20
OPENAI_COMPUTER_ALLOWED_STAGES=
OPENAI_COMPUTER_REQUIRE_APPROVAL=true

# Multi-agent execution
SUB_AGENT_COUNT=3
AGENT_PARALLELISM=3
MAX_REVIEW_RETRIES=1
MAX_PROTOCOL_RETRIES=1
AGENT_OUTPUT_CHAR_LIMIT=12000
MAX_COMMAND_SECONDS=300

# Process hardening
# isolated: Agent gets a dedicated HOME and cannot read the Bot user's home.
# preserve: compatibility mode; exposes the parent HOME to the Agent.
AGENT_HOME_MODE=isolated
# Additional variables explicitly forwarded to child CLI processes.
# DISCORD_* variables are hard-denied even when listed here. OPENAI_API_KEY is
# intentionally not forwarded by default; the parent provider uses it directly.
AGENT_ENV_ALLOWLIST=
AGENT_CANCEL_GRACE_SECONDS=3
CHECKPOINT_ENABLED=true
ARTIFACT_PROMOTION_ENABLED=true
ARTIFACT_MAX_FILES=500
ARTIFACT_MAX_BYTES=104857600

# OS sandbox for non-Codex generic commands.
# auto: use bubblewrap when installed; otherwise reject generic commands.
# bwrap: require bubblewrap. none: no OS wrapper.
AGENT_SANDBOX_BACKEND=auto
AGENT_ALLOW_UNSANDBOXED_GENERIC=false
AGENT_NETWORK_POLICY=deny

# Research limits and convergence
MAX_ROUNDS=3
FRESH_INTERVAL=1
CONVERGENCE_PATIENCE=2
CONVERGENCE_NO_EVIDENCE_PATIENCE=2
CONVERGENCE_MIN_PROGRESS=0.05
CONVERGENCE_REQUIRE_HIGH_CONFIDENCE=true
REPORT_INTERVAL_SECONDS=60
MAX_TURNS_PER_CONVERSATION=4
CONVERSATION_TIMEOUT_SECONDS=60
MAX_AGENT_CALLS=0
MAX_API_CALLS=0
MAX_TOTAL_TOKENS=0

# Literature search
PAPER_PROVIDER=arxiv

# Container host paths. The same compose.yaml runs natively on Docker Desktop
# (linux/amd64) and Jetson Linux (linux/arm64).
INSTALL_CODEX=true
RA_RUNTIME_DIR=./runtime
RA_RESEARCH_DIR=./research_runs
RA_CODEX_HOME_DIR=./codex-home
CONTAINER_PRINT_PLATFORM=true
CONTAINER_HEALTH_REQUIRE_CODEX=false
