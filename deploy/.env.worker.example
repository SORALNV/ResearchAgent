# Copy to deploy/.env.worker on the GPU/Worker host. This file deliberately has
# no Discord, OpenAI, Codex, or Kaggle credentials.
WORKER_TOKEN=replace-with-a-distinct-long-random-token
WORKER_BIND_ADDRESS=127.0.0.1
WORKER_BIND_PORT=8090
WORKER_PUBLIC_URL=
RA_WORKER_RUNTIME_DIR=../worker-runtime

# CPU-only base Worker. The GPU compose overlay changes accelerator/device
# access; set the actual inventory advertised to Core.
WORKER_ACCELERATORS=cpu,gpu
WORKER_DOMAINS=research,kaggle
WORKER_GPU_COUNT=1
WORKER_GPU_MEMORY_MB=
WORKER_CPU_CORES=
WORKER_MEMORY_MB=
WORKER_STORAGE_MB=
WORKER_NETWORK_AVAILABLE=true
WORKER_LABELS=training,inference,remote_worker,smoke_test

WORKER_MAX_BUNDLE_FILES=5000
WORKER_MAX_BUNDLE_BYTES=67108864
WORKER_ARTIFACT_MAX_FILES=2000
WORKER_ARTIFACT_MAX_BYTES=4294967296
WORKER_MAX_REQUEST_BYTES=100663296
WORKER_HTTP_LOG=true
CONTAINER_PRINT_PLATFORM=true
