# Core only. Do not copy Discord or Worker tokens here.
RESEARCH_AGENT_CORE_TOKEN=
RESEARCH_AGENT_DATA_DIR=/var/lib/research-agent/core
RESEARCH_AGENT_DATABASE=platform.sqlite3

CODEX_COMMAND=codex
OPENAI_API_KEY=
OPENAI_MODEL=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_ORGANIZATION=
OPENAI_PROJECT=
AGENT_ENV_ALLOWLIST=OPENAI_API_KEY
AGENT_HOME_MODE=isolated
AGENT_SANDBOX_BACKEND=auto
AGENT_ALLOW_UNSANDBOXED_GENERIC=false

INSTALL_COMPUTER_USE=false
COMPUTER_USE_ENABLED=false
COMPUTER_USE_HEADLESS=true
COMPUTER_USE_START_URL=https://www.kaggle.com/
COMPUTER_USE_ALLOWED_DOMAINS=kaggle.com
OPENAI_COMPUTER_TOOL_JSON=

KAGGLE_COMMAND=kaggle
KAGGLE_API_TOKEN=
KAGGLE_USERNAME=

MAX_CONCURRENT_COMPUTE_JOBS=2
COMPUTE_POLL_SECONDS=15
ALLOW_KAGGLE_FOR_RESEARCH=false
PAID_COMPUTE_BACKENDS=gpu_vm
REMOTE_COMPUTE_WORKERS_JSON=[]

CORE_BIND_ADDRESS=127.0.0.1
CORE_PORT=8080
