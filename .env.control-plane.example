# Portable deployment
RESEARCH_AGENT_PLATFORM=linux/amd64
# Jetson: linux/arm64
CONTROL_PLANE_MODE=core
PROJECT_ROOT=.
CONTROL_PLANE_RUNTIME_ROOT=/runtime
CONTROL_PLANE_DATABASE=/runtime/control-plane.sqlite3
CONTROL_PLANE_PROJECTS_ROOT=/runtime/projects
CONTROL_PLANE_JOBS_ROOT=/runtime/jobs
RUNTIME_STATE_DIR=./runtime/state
CODEX_AUTH_DIR=./runtime/codex
CODEX_HOME=/home/research/.codex

# Discord private control plane
DISCORD_BOT_TOKEN=
DISCORD_CHANNEL_ID=
DISCORD_IMPORTANT_CHANNEL_ID=
DISCORD_LOG_CHANNEL_ID=
DISCORD_AGENT_INBOX_CHANNEL_ID=
DISCORD_WORK_SESSIONS_FORUM_ID=
DISCORD_APPROVAL_CHANNEL_ID=
DISCORD_AGENT_OPS_CHANNEL_ID=
DISCORD_ALLOWED_USER_IDS=
DISCORD_ALLOWED_GUILD_IDS=
DISCORD_PROGRESS_MIN_INTERVAL_SECONDS=10
DISCORD_WORKER_QUEUE_SIZE=32

# Internal Codex / OpenAI provider routing
AGENT_RUNTIME_ORDER=codex_cli,openai_responses
MAIN_AGENT_RUNTIME_ORDER=codex_cli,openai_responses
SUB_AGENT_RUNTIME_ORDER=codex_cli
REVIEW_AGENT_RUNTIME_ORDER=openai_responses,codex_cli
FRESH_AGENT_RUNTIME_ORDER=openai_responses,codex_cli
PLANNING_AGENT_RUNTIME_ORDER=openai_responses,codex_cli
MAIN_AGENT_COMMAND=codex
SUB_AGENT_COMMAND=codex
REVIEW_AGENT_COMMAND=codex
FRESH_AGENT_COMMAND=codex
OPENAI_API_KEY=
OPENAI_MODEL=
OPENAI_REASONING_EFFORT=

# Optional OpenAI Computer Use. Keep disabled until a separate isolated bridge exists.
OPENAI_COMPUTER_ENABLED=false
OPENAI_COMPUTER_MODEL=
OPENAI_COMPUTER_BRIDGE_URL=
OPENAI_COMPUTER_BRIDGE_TOKEN=
OPENAI_COMPUTER_ALLOWED_STAGES=
OPENAI_COMPUTER_REQUIRE_APPROVAL=true

# Scheduler
SCHEDULER_WORKERS=2
SCHEDULER_QUEUE_SIZE=256
REQUEUE_INTERRUPTED_JOBS=false
ENABLE_FAKE_COMPUTE_BACKEND=false
ENABLE_LOCAL_CPU_BACKEND=true
LOCAL_CPU_MAX_RAM_GB=96

# Kaggle Notebook backend
ENABLE_KAGGLE_NOTEBOOK_BACKEND=true
KAGGLE_EXECUTABLE=kaggle
KAGGLE_API_TOKEN=
KAGGLE_USERNAME=
KAGGLE_KEY=
KAGGLE_CONFIG_DIR=
KAGGLE_PACKAGES_ROOT=/runtime/kaggle/packages
KAGGLE_OUTPUTS_ROOT=/runtime/kaggle/outputs
KAGGLE_CLI_TIMEOUT_SECONDS=120
KAGGLE_POLL_INTERVAL_SECONDS=15
KAGGLE_MAX_POLL_SECONDS=21600
KAGGLE_MAX_VRAM_GB=16

# Owned GPU PC via Tailscale/VPN Worker API
REMOTE_GPU_WORKER_URL=
REMOTE_GPU_WORKER_TOKEN=
REMOTE_GPU_VRAM_GB=0
REMOTE_GPU_RAM_GB=0

# Rented GPU VM / RunPod-like Worker API
GPU_VM_WORKER_URL=
GPU_VM_WORKER_TOKEN=
GPU_VM_VRAM_GB=0
GPU_VM_RAM_GB=0

# Harness safety
AGENT_HOME_MODE=isolated
AGENT_ENV_ALLOWLIST=
AGENT_CANCEL_GRACE_SECONDS=3
CHECKPOINT_ENABLED=true
ARTIFACT_PROMOTION_ENABLED=true
AGENT_SANDBOX_BACKEND=auto
AGENT_ALLOW_UNSANDBOXED_GENERIC=false
AGENT_NETWORK_POLICY=deny
MAX_ROUNDS=3
MAX_AGENT_CALLS=0
MAX_TOTAL_TOKENS=0
PAPER_PROVIDER=arxiv
