# Production hardening settings. Merge these values into the Core .env.

# State-changing Discord operations are fail-closed by default. Add the Discord
# user IDs that may create/use channel sessions. The setup actor is persisted as
# the channel-session owner; owners and global IDs may approve, interrupt, submit,
# archive, and operate Compute for that channel.
DISCORD_ACCESS_CONTROL_REQUIRED=true
DISCORD_ALLOWED_USER_IDS=
DISCORD_ADMIN_USER_IDS=

# Remote Worker response and artifact limits. Every artifact must advertise an
# exact size and SHA-256, remain on the Worker origin, and fit these bounds.
REMOTE_WORKER_MAX_RESPONSE_BYTES=8388608
REMOTE_ARTIFACT_MAX_FILES=2000
REMOTE_ARTIFACT_MAX_FILE_BYTES=2147483648
REMOTE_ARTIFACT_MAX_TOTAL_BYTES=4294967296
